{
  "name": "gitclone",
  "version": "1.0.0",
  "private": true,
  "description": "GitClone premium developer platform landing page built with Next.js, TypeScript, TailwindCSS, and Framer Motion.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "assets": "node scripts/generate-brand-assets.mjs",
    "api:install": "npm --prefix backend install",
    "api:dev": "npm --prefix backend run dev",
    "api:build": "npm --prefix backend run build",
    "api:start": "npm --prefix backend run start",
    "api:typecheck": "npm --prefix backend run typecheck",
    "backend:install": "npm --prefix backend install",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "backend:start": "npm --prefix backend run start",
    "backend:typecheck": "npm --prefix backend run typecheck"
  },
  "dependencies": {
    "framer-motion": "12.39.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.6",
    "sharp": "0.34.5",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "engines": {
    "node": ">=20.20.0"
  }
}
