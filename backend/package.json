{
  "name": "gitclone-api",
  "version": "1.0.0",
  "private": true,
  "description": "GitClone API service for repositories, issues, pull requests, and deployments.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "fastify": "5.8.5",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.20.0"
  }
}
