[Unit]
Description=GitClone API Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/gitclone-api/app
Environment=NODE_ENV=production
Environment=PORT=4000
Environment=HOST=0.0.0.0
Environment=DATABASE_FILE=/opt/gitclone-api/app/data/gitclone.db.json
EnvironmentFile=-/opt/gitclone-api/app/.env
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
